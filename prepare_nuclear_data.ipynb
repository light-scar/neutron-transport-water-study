   "source": [
    "from pathlib import Path\n",
    "from urllib.request import urlopen\n",
    "import shutil\n",
    "\n",
    "url = \"https://anl.box.com/shared/static/9igk353zpy8fn9ttvtrqgzvw1vtejoz6.xz\"\n",
    "\n",
    "download_folder = Path(\"nuclear_data\").resolve()\n",
    "download_folder.mkdir(exist_ok=True)\n",
    "\n",
    "archive_path = download_folder / \"endfb71.tar.xz\"\n",
    "partial_path = download_folder / \"endfb71.tar.xz.part\"\n",
    "\n",
    "if archive_path.exists():\n",
    "    print(\"Using previously downloaded archive:\", archive_path)\n",
    "else:\n",
    "    print(\"Downloading official nuclear data...\", flush=True)\n",
    "\n",
    "    with urlopen(url, timeout=120) as response:\n",
    "        first_chunk = response.read(1024 * 1024)\n",
    "\n",
    "        # Reject an HTML error page before saving it as nuclear data.\n",
    "        if not first_chunk.startswith(b\"\\xfd7zXZ\\x00\"):\n",
    "            raise RuntimeError(\"Server did not return an XZ archive.\")\n",
    "\n",
    "        total = response.headers.get(\"Content-Length\")\n",
    "        total = int(total) if total else None\n",
    "\n",
    "        if total:\n",
    "            print(f\"Download size: {total / 1024**3:.2f} GiB\", flush=True)\n",
    "            if shutil.disk_usage(download_folder).free < total + 1024**3:\n",
    "                raise RuntimeError(\"Insufficient free disk space.\")\n",
    "\n",
    "        downloaded = len(first_chunk)\n",
    "        next_report = 100 * 1024**2\n",
    "\n",
    "        with partial_path.open(\"wb\") as output:\n",
    "            output.write(first_chunk)\n",
    "\n",
    "            while chunk := response.read(1024 * 1024):\n",
    "                output.write(chunk)\n",
    "                downloaded += len(chunk)\n",
    "\n",
    "                if downloaded >= next_report:\n",
    "                    print(\n",
    "                        f\"Downloaded {downloaded / 1024**2:.0f} MiB\",\n",
    "                        flush=True,\n",
    "                    )\n",
    "                    next_report = downloaded + 100 * 1024**2\n",
    "\n",
    "    if total and downloaded != total:\n",
    "        raise RuntimeError(\"Download incomplete. Rerun this cell.\")\n",
    "\n",
    "    partial_path.replace(archive_path)\n",
    "    print(\"Download complete.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9ace4eb5-b0a7-40bf-9d02-1401b91ed1fd",
   "metadata": {},
   "outputs": [],
   "source": [
    "import tarfile\n",
    "import os\n",
    "import openmc.data\n",
    "\n",
    "water_folder = download_folder / \"water_endfb71\"\n",
    "water_folder.mkdir(exist_ok=True)\n",
    "\n",
    "required = {\n",
    "    \"H1.h5\": (\"H1\", \"neutron\", openmc.data.IncidentNeutron),\n",
    "    \"O16.h5\": (\"O16\", \"neutron\", openmc.data.IncidentNeutron),\n",
    "    \"c_H_in_H2O.h5\": (\n",
    "        \"c_H_in_H2O\", \"thermal\", openmc.data.ThermalScattering\n",
    "    ),\n",
    "}\n",
    "\n",
    "found = set()\n",
    "\n",
    "print(\"Scanning archive and extracting water data...\", flush=True)\n",
    "\n",
    "with tarfile.open(archive_path, \"r|xz\") as archive:\n",
    "    for member in archive:\n",
    "        filename = Path(member.name).name\n",
    "\n",
    "        if member.isfile() and filename in required:\n",
    "            if filename in found:\n",
    "                raise RuntimeError(f\"Duplicate dataset: {filename}\")\n",
    "\n",
    "            destination = water_folder / filename\n",
    "            with archive.extractfile(member) as source:\n",
    "                with destination.open(\"wb\") as output:\n",
    "                    shutil.copyfileobj(source, output)\n",
    "\n",
    "            found.add(filename)\n",
    "            print(\"Extracted:\", filename, flush=True)\n",
    "\n",
    "missing = set(required) - found\n",
    "if missing:\n",
    "    raise RuntimeError(f\"Missing datasets: {missing}\")\n",
    "\n",
    "library = openmc.data.DataLibrary()\n",
    "\n",
    "for filename, (name, data_type, reader) in required.items():\n",
    "    path = water_folder / filename\n",
    "    dataset = reader.from_hdf5(str(path))\n",
    "    library.register_file(str(path))\n",
    "\n",
    "    if library.get_by_material(name, data_type) is None:\n",
    "        raise RuntimeError(f\"Unexpected dataset identity: {filename}\")\n",
    "\n",
    "    print(\"Loaded successfully:\", name)\n",
    "    del dataset\n",
    "\n",
   index_path = water_folder / "cross_sections.xml"
library.export_to_xml(str(index_path))

print("\nNuclear-data setup complete.")
print("Index saved to:", index_path)
print("You can now run the main simulation notebook."),
   ]
  }
